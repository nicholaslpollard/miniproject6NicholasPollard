# Copy this file to .env and fill in real values. Never commit .env.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Local development: True. Deployment: False.
DJANGO_DEBUG=True

# Comma-separated host names.
# Local development:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Deployment example:
# DJANGO_ALLOWED_HOSTS=dev-student17.fhsucyber.com

# Comma-separated origins (scheme included). Leave empty for local development.
# Deployment example (HTTPS reverse proxy):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dev-student17.fhsucyber.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Send session/CSRF cookies only over HTTPS. Optional: if left empty it defaults to
# the opposite of DJANGO_DEBUG (False locally, True in deployment).
# Local development (plain HTTP):
DJANGO_SECURE_COOKIES=
# Deployment example (HTTPS reverse proxy):
# DJANGO_SECURE_COOKIES=True

# Deployment checklist:
#   pip install -r requirements.txt
#   python manage.py migrate
#   python manage.py collectstatic --noinput   (WhiteNoise serves the collected files)
#   python manage.py runserver 0.0.0.0:8000
